---
import type { Lang, PageKey } from '../i18n';
import { getAlternateLinks, getDictionary } from '../i18n';

export interface CustomAlternate {
  lang: Lang;
  path: string;
  href: string;
}

interface Props {
  lang: Lang;
  page?: PageKey;
  customAlternates?: CustomAlternate[];
}

const { lang, page = 'home', customAlternates } = Astro.props;
const rawAlternates = customAlternates
  ? customAlternates.map((alt) => {
      const d = getDictionary(alt.lang);
      return {
        lang: alt.lang,
        nativeName: d.langNative,
        path: alt.path,
        href: alt.href,
        suggestionPrompt: d.suggestionPrompt,
        suggestionAction: d.suggestionAction,
        suggestionDismiss: d.suggestionDismiss,
      };
    })
  : getAlternateLinks(page);
---

<aside
  id="lang-suggestion-bar"
  class="lang-suggestion"
  aria-label="Language suggestion"
  hidden
  data-current-lang={lang}
  data-alternates={JSON.stringify(rawAlternates)}
>
  <div class="container lang-suggestion__inner">
    <p id="lang-suggestion-text" class="lang-suggestion__text"></p>
    <div class="lang-suggestion__actions">
      <a
        id="lang-suggestion-link"
        class="lang-suggestion__link"
        href={rawAlternates[0]?.path || '/'}
      ></a>
      <button
        id="lang-suggestion-dismiss"
        type="button"
        class="lang-suggestion__dismiss"
      >
        ×
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    const bar = document.getElementById('lang-suggestion-bar');
    if (!bar) return;
    try {
      if (sessionStorage.getItem('edithsi_lang_dismissed') === '1') return;
    } catch (_) {}

    const currentLang = bar.getAttribute('data-current-lang') || 'en';
    let alternates = [];
    try {
      alternates = JSON.parse(bar.getAttribute('data-alternates') || '[]');
    } catch (_) {
      return;
    }

    const rawLangs =
      navigator.languages && navigator.languages.length
        ? navigator.languages
        : [navigator.language || ''];

    let matched = null;
    for (let i = 0; i < rawLangs.length; i++) {
      const code = String(rawLangs[i]).toLowerCase().split('-')[0];
      const found = alternates.find(function (item) {
        return item.lang === code;
      });
      if (found) {
        matched = found;
        break;
      }
    }

    if (!matched || matched.lang === currentLang) return;

    const textEl = document.getElementById('lang-suggestion-text');
    const linkEl = document.getElementById('lang-suggestion-link');
    const dismissBtn = document.getElementById('lang-suggestion-dismiss');
    if (!textEl || !linkEl || !dismissBtn) return;

    bar.setAttribute('lang', matched.lang);
    textEl.textContent = matched.suggestionPrompt;
    linkEl.textContent = matched.suggestionAction;
    linkEl.setAttribute('href', matched.path);
    dismissBtn.setAttribute('aria-label', matched.suggestionDismiss);
    bar.removeAttribute('hidden');

    dismissBtn.addEventListener('click', function () {
      bar.setAttribute('hidden', '');
      try {
        sessionStorage.setItem('edithsi_lang_dismissed', '1');
      } catch (_) {}
    });
  })();
</script>
