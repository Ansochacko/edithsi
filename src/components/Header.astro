---
import { SITE_NAME } from '../config';
import {
  AUDIENCE_SLUGS,
  getDictionary,
  getPagePath,
  getAudiencePath,
  getAlternateLinks,
  type Lang,
  type PageKey,
} from '../i18n';
import type { CustomAlternate } from './LanguageSuggestion.astro';

interface Props {
  lang: Lang;
  page?: PageKey;
  customAlternates?: CustomAlternate[];
}

const { lang, page, customAlternates } = Astro.props;
const t = getDictionary(lang);

const alternates = customAlternates
  ? customAlternates.map((alt) => ({
      lang: alt.lang,
      nativeName: getDictionary(alt.lang).langNative,
      path: alt.path,
      href: alt.href,
    }))
  : getAlternateLinks(page ?? 'home');

const isAudiencePage = page?.startsWith('for/') ?? false;
const isPlatformPage = page === 'compare' || (page?.startsWith('platforms/') ?? false);

const NAV_EXTRAS: Record<Lang, { compare: string; payIndex: string }> = {
  en: { compare: 'Compare Platforms', payIndex: 'Pay Index' },
  fi: { compare: 'Vertaa alustoja', payIndex: 'Palkkioindeksi' },
  sv: { compare: 'Jämför plattformar', payIndex: 'Ersättningsindex' },
  de: { compare: 'Plattform-Vergleich', payIndex: 'Honorar-Index' },
  fr: { compare: 'Comparer les plateformes', payIndex: 'Indice des tarifs' },
  es: { compare: 'Comparar plataformas', payIndex: 'Índice salarial' },
};
const extras = NAV_EXTRAS[lang];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={getPagePath(lang, 'home')} class="site-brand">
      <span class="site-brand__name">{SITE_NAME}</span>
      <span class="site-brand__tag">Nordic AI Work Registry</span>
    </a>

    <div class="site-nav-wrap">
      <nav aria-label={t.nav.ariaLabel}>
        <ul class="site-nav">
          <li>
            <a
              href={getPagePath(lang, 'home')}
              class="site-nav__link"
              aria-current={page === 'home' ? 'page' : undefined}
            >
              {t.nav.home}
            </a>
          </li>
          <li>
            <a
              href={getPagePath(lang, 'roles')}
              class="site-nav__link"
              aria-current={page === 'roles' ? 'page' : undefined}
            >
              {t.nav.roles}
            </a>
          </li>
          <li>
            <details class="lang-menu nav-dropdown" id="for-you-menu-details">
              <summary
                class:list={[
                  'site-nav__link',
                  'nav-dropdown__summary',
                  { 'site-nav__link--active': isAudiencePage },
                ]}
              >
                <span>{t.nav.forYou}</span>
                <svg class="lang-menu__caret" viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1.5L6 6.5L11 1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <ul class="lang-menu__list nav-dropdown__list" aria-label={t.nav.forYou}>
                {
                  AUDIENCE_SLUGS.map((slug) => {
                    const audPath = getAudiencePath(lang, slug);
                    const isCurrent = page === `for/${slug}`;
                    return (
                      <li>
                        <a
                          href={audPath}
                          class="lang-menu__link"
                          aria-current={isCurrent ? 'page' : undefined}
                        >
                          <span>{t.audiences[slug].label}</span>
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </details>
          </li>
          <li>
            <a
              href={getPagePath(lang, 'compare')}
              class="site-nav__link"
              aria-current={isPlatformPage ? 'page' : undefined}
            >
              {extras.compare}
            </a>
          </li>
          <li>
            <a
              href={getPagePath(lang, 'pay-index')}
              class="site-nav__link"
              aria-current={page === 'pay-index' ? 'page' : undefined}
            >
              {extras.payIndex}
            </a>
          </li>
          <li>
            <a
              href={getPagePath(lang, 'how-it-works')}
              class="site-nav__link"
              aria-current={page === 'how-it-works' ? 'page' : undefined}
            >
              {t.nav.howItWorks}
            </a>
          </li>
        </ul>
      </nav>

      <details class="lang-menu" id="lang-menu-details">
        <summary class="lang-menu__summary" aria-label={`${t.nav.languageLabel}: ${t.langNative}`}>
          <span>{t.langNative}</span>
          <svg class="lang-menu__caret" viewBox="0 0 12 8" aria-hidden="true">
            <path d="M1 1.5L6 6.5L11 1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ul class="lang-menu__list" aria-label={t.nav.languageLabel}>
          {
            alternates.map((alt) => (
              <li>
                <a
                  href={alt.path}
                  lang={alt.lang}
                  hreflang={alt.lang}
                  class="lang-menu__link"
                  aria-current={alt.lang === lang ? 'true' : undefined}
                >
                  <span>{alt.nativeName}</span>
                  <span class="lang-menu__code">{alt.lang}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</header>

<script src="../scripts/header-menus.ts"></script>
