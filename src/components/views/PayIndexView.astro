---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../FaqList.astro';
import AuthorBox from '../AuthorBox.astro';
import payIndex from '../../data/pay-index/2026-11.json';
import rolesRaw from '../../data/roles.json';
import { SITE_URL, CHECKED_ON, buildGoUrl } from '../../config';
import { getPayIndexPageContent } from '../../data/hubPagesContent';
import {
  getDictionary,
  getPagePath,
  getPlatformPath,
  getAudiencePath,
  type AudienceSlug,
  type PlatformSlug,
  type Lang,
} from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const content = getPayIndexPageContent(lang);

const breadcrumbs = [
  { name: t.nav.home, url: getPagePath(lang, 'home') },
  { name: content.h1, url: getPagePath(lang, 'pay-index') },
];

const csvEditionUrl = `${SITE_URL}/data/edithsi-ai-work-pay-index-${payIndex.edition}.csv`;
const csvLatestUrl = `${SITE_URL}/data/edithsi-ai-work-pay-index-latest.csv`;

const UI_LABELS: Record<
  Lang,
  {
    lastUpdated: string;
    editionLabel: string;
    tableH2: string;
    officialNoRef: string;
    officialSourceText: string;
    citationHeading: string;
    citationText: string;
    faqHeading: string;
  }
> = {
  en: {
    lastUpdated: 'Sample date & last checked',
    editionLabel: 'Edition',
    tableH2: `What are the posted hourly pay ranges by field and platform? (${payIndex.edition})`,
    officialNoRef: 'official link · no referral',
    officialSourceText: 'Official source ↗',
    citationHeading: 'How to cite this dataset (CC BY 4.0)',
    citationText: `Journalists, researchers, and AI assistants may freely cite this dataset under Creative Commons Attribution 4.0 (CC BY 4.0). Recommended attribution: "Edithsi AI Work Pay Index (${payIndex.edition}), compiled from official public platform listings on ${payIndex.sample_date}, https://edithsi.com/pay-index/".`,
    faqHeading: 'Frequently asked questions about the Edithsi AI Work Pay Index',
  },
  fi: {
    lastUpdated: 'Otantapäivä ja tarkistettu',
    editionLabel: 'Julkaisu',
    tableH2: `Mitkä ovat ilmoitetut tuntipalkkiot aloittain ja alustoittain? (${payIndex.edition})`,
    officialNoRef: 'virallinen linkki · ei suosittelukoodia',
    officialSourceText: 'Virallinen lähde ↗',
    citationHeading: 'Näin viittaat tähän aineistoon (CC BY 4.0)',
    citationText: `Toimittajat, tutkijat ja tekoälyavustajat voivat viitata aineistoon vapaasti Creative Commons CC BY 4.0 -lisenssillä: "Edithsi AI Work Pay Index (${payIndex.edition}), koottu alustojen julkisista hakuilmoituksista ${payIndex.sample_date}, https://edithsi.com/fi/pay-index/".`,
    faqHeading: 'Usein kysytyt kysymykset Edithsi-palkkioindeksistä',
  },
  sv: {
    lastUpdated: 'Urvalsdatum & senast kontrollerad',
    editionLabel: 'Utgåva',
    tableH2: `Vilka är de angivna timarvodespannen per område och plattform? (${payIndex.edition})`,
    officialNoRef: 'officiell länk · ingen värvningskod',
    officialSourceText: 'Officiell källa ↗',
    citationHeading: 'Så citerar du detta dataset (CC BY 4.0)',
    citationText: `Journalister och forskare kan fritt citera detta dataset under CC BY 4.0: "Edithsi AI Work Pay Index (${payIndex.edition}), kontrollerat ${payIndex.sample_date}, https://edithsi.com/sv/pay-index/".`,
    faqHeading: 'Vanliga frågor om Edithsi AI Work Pay Index',
  },
  de: {
    lastUpdated: 'Stichtag & zuletzt geprüft',
    editionLabel: 'Ausgabe',
    tableH2: `Wie hoch sind die veröffentlichten Stundensätze nach Fachgebiet und Plattform? (${payIndex.edition})`,
    officialNoRef: 'offizieller Link · kein Empfehlungscode',
    officialSourceText: 'Offizielle Quelle ↗',
    citationHeading: 'Zitierhinweis für Medien & Forschung (CC BY 4.0)',
    citationText: `Journalisten und Forschende können diesen Datensatz unter CC BY 4.0 frei zitieren: "Edithsi AI Work Pay Index (${payIndex.edition}), erhoben am ${payIndex.sample_date}, https://edithsi.com/de/pay-index/".`,
    faqHeading: 'Häufige Fragen zum Edithsi KI-Honorar-Index',
  },
  fr: {
    lastUpdated: 'Date d’échantillonnage et vérification',
    editionLabel: 'Édition',
    tableH2: `Quels sont les tarifs horaires affichés par domaine et par plateforme ? (${payIndex.edition})`,
    officialNoRef: 'lien officiel · sans parrainage',
    officialSourceText: 'Source officielle ↗',
    citationHeading: 'Comment citer ce jeu de données (CC BY 4.0)',
    citationText: `Les journalistes et chercheurs peuvent citer librement ce jeu de données sous licence CC BY 4.0 : « Edithsi AI Work Pay Index (${payIndex.edition}), vérifié le ${payIndex.sample_date}, https://edithsi.com/fr/pay-index/ ».`,
    faqHeading: 'Questions fréquentes sur l’indice des tarifs IA Edithsi',
  },
  es: {
    lastUpdated: 'Fecha de muestra y verificación',
    editionLabel: 'Edición',
    tableH2: `¿Cuáles son los rangos por hora publicados por especialidad y plataforma? (${payIndex.edition})`,
    officialNoRef: 'enlace oficial · sin código de referido',
    officialSourceText: 'Fuente oficial ↗',
    citationHeading: 'Cómo citar este conjunto de datos (CC BY 4.0)',
    citationText: `Periodistas e investigadores pueden citar libremente este conjunto de datos bajo licencia CC BY 4.0: "Edithsi AI Work Pay Index (${payIndex.edition}), verificado el ${payIndex.sample_date}, https://edithsi.com/es/pay-index/".`,
    faqHeading: 'Preguntas frecuentes sobre el Índice salarial de IA Edithsi',
  },
};

const ui = UI_LABELS[lang];
---

<BaseLayout
  lang={lang}
  page="pay-index"
  title={content.title}
  description={content.metaDescription}
  breadcrumbs={breadcrumbs}
  articleSchema={{ datePublished: CHECKED_ON, dateModified: CHECKED_ON }}
  datasetSchema={{
    name: `Edithsi AI Work Pay Index (${payIndex.edition})`,
    description: content.metaDescription,
    edition: payIndex.edition,
    dateModified: payIndex.sample_date,
    csvUrl: csvEditionUrl,
    latestCsvUrl: csvLatestUrl,
  }}
  faqsSchema={content.faqs}
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">
        {ui.editionLabel}: {payIndex.edition} · {ui.lastUpdated}:{' '}
        <time datetime={payIndex.sample_date}>{payIndex.sample_date}</time>
      </span>
      <h1>{content.h1}</h1>

      <div class="direct-answer-box">
        <p class="direct-answer-box__text">{content.directAnswer}</p>
      </div>

      <div class="btn-group">
        <a
          href={`/data/edithsi-ai-work-pay-index-${payIndex.edition}.csv`}
          download={`edithsi-ai-work-pay-index-${payIndex.edition}.csv`}
          class="btn btn--primary"
        >
          {content.downloadCsvLabel} ({payIndex.edition} CSV) ↓
        </a>
        <a href={getPagePath(lang, 'compare')} class="btn btn--secondary">
          Compare All 6 Platforms →
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pay-index-table-heading">
    <div class="container">
      <h2 id="pay-index-table-heading">{ui.tableH2}</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              {content.tableHeaders.map((h) => (
                <th scope="col">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {payIndex.entries.map((entry) => {
              const isMercor = entry.platform_slug === 'mercor';
              const mercorRole = isMercor
                ? rolesRaw.find((r) => r.url === entry.source_url)
                : undefined;
              const applyHref =
                isMercor && mercorRole
                  ? buildGoUrl(mercorRole.id, 'pay-index')
                  : entry.source_url;
              return (
                <tr>
                  <td>
                    <a href={getAudiencePath(lang, entry.audience as AudienceSlug)}>
                      {entry.field}
                    </a>
                  </td>
                  <td>
                    <strong>
                      <a href={getPlatformPath(lang, entry.platform_slug as PlatformSlug)}>
                        {entry.platform_name}
                      </a>
                    </strong>
                  </td>
                  <td>
                    <strong>{entry.platform_name}: {entry.role_title}</strong>
                    <div class="table-sub">{entry.notes}</div>
                  </td>
                  <td class="mono-cell">
                    <strong>{entry.posted_range}</strong>
                    <div class="table-sub">{entry.pay_model}</div>
                  </td>
                  <td>{entry.eu_finland_status}</td>
                  <td>
                    {isMercor ? (
                      <div class="table-action-cell">
                        <a
                          href={applyHref}
                          target="_blank"
                          rel="sponsored noopener noreferrer"
                          class="table-apply-link"
                        >
                          {t.common.applyOnMercor} ↗
                        </a>
                        <span class="referral-micro">{t.common.referralMicroLabel}</span>
                      </div>
                    ) : (
                      <div class="table-action-cell">
                        <a
                          href={applyHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="table-apply-link"
                        >
                          {ui.officialSourceText}
                        </a>
                        <span class="referral-micro">{ui.officialNoRef}</span>
                      </div>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pay-index-method-heading">
    <div class="container">
      <h2 id="pay-index-method-heading">{content.methodologyTitle}</h2>
      <div class="article-prose">
        {content.methodologyParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <div class="disclosure-banner mt-space-6">
        <h3 class="text-1rem mb-space-2">{ui.citationHeading}</h3>
        <p>{ui.citationText}</p>
      </div>
    </div>
  </section>

  {content.sections.map((sec, idx) => (
    <section class="section" aria-labelledby={`pay-sec-${idx}`}>
      <div class="container">
        <h2 id={`pay-sec-${idx}`}>{sec.h2}</h2>
        <div class="article-prose">
          {sec.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section" aria-labelledby="changelog-heading">
    <div class="container">
      <h2 id="changelog-heading">{content.changelogTitle}</h2>
      <ul class="checklist-box">
        {payIndex.changelog.map((log) => (
          <li class="checklist-box__item">
            <strong>{log.edition} ({log.date}):</strong> {log.summary}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="pay-faq-heading">
    <div class="container">
      <h2 id="pay-faq-heading">{ui.faqHeading}</h2>
      <FaqList items={content.faqs} />
      <AuthorBox lang={lang} />
    </div>
  </section>
</BaseLayout>
