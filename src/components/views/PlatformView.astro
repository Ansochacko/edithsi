---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../FaqList.astro';
import AuthorBox from '../AuthorBox.astro';
import platforms from '../../data/platforms.json';
import rolesRaw from '../../data/roles.json';
import { CHECKED_ON, buildGoUrl, buildMicro1GoUrl } from '../../config';
import { getPlatformPageContent } from '../../data/platformContent';
import {
  PLATFORM_SLUGS,
  getDictionary,
  getPagePath,
  getPlatformPath,
  getAudiencePath,
  type AudienceSlug,
  type PlatformSlug,
  type Lang,
} from '../../i18n';

interface Props {
  lang: Lang;
  slug: PlatformSlug;
}

const { lang, slug } = Astro.props;
const t = getDictionary(lang);
const platform = platforms.find((p) => p.slug === slug)!;
const content = getPlatformPageContent(lang, slug);
const isMercor = slug === 'mercor';
const isMicro1 = slug === 'micro1';

const breadcrumbs = [
  { name: t.nav.home, url: getPagePath(lang, 'home') },
  { name: 'Compare Platforms', url: getPagePath(lang, 'compare') },
  { name: platform.name, url: getPlatformPath(lang, slug) },
];

const UI_LABELS: Record<
  Lang,
  {
    lastUpdated: string;
    directAnswerLabel: string;
    disclosureLabel: string;
    factsH2: string;
    colFact: string;
    colValue: string;
    rowOperator: string;
    rowOfficialUrl: string;
    rowWorkType: string;
    rowPayRange: string;
    rowPayment: string;
    rowCountries: string;
    rowSteps: string;
    rowReferral: string;
    rowChecked: string;
    referralYes: string;
    referralMicro1: string;
    referralNo: string;
    browseMicro1Jobs: string;
    rolesTableH2: string;
    colField: string;
    colRole: string;
    colPostedRange: string;
    colDate: string;
    colSource: string;
    officialLinkLabel: string;
    noReferralMicro: string;
    matchingAudiencesH2: string;
    compareOthersH2: string;
    faqH2: string;
  }
> = {
  en: {
