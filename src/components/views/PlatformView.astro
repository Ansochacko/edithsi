const ui = UI_LABELS[lang];
---

<BaseLayout
  lang={lang}
  page={`platforms/${slug}`}
  title={content.title}
  description={content.metaDescription}
  breadcrumbs={breadcrumbs}
  articleSchema={{ datePublished: CHECKED_ON, dateModified: CHECKED_ON }}
  faqsSchema={content.faqs}
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">
        {platform.name} · {ui.lastUpdated}: <time datetime={CHECKED_ON}>{CHECKED_ON}</time>
      </span>
      <h1>{content.h1}</h1>

      <div class="direct-answer-box" role="region" aria-label={ui.directAnswerLabel}>
        <p class="direct-answer-box__text">{content.directAnswer}</p>
      </div>

      <div class="disclosure-banner" role="note" aria-label={ui.disclosureLabel}>
        <p>{content.fairnessDisclosure}</p>
      </div>

      <div class="btn-group">
        {isMercor ? (
          <div class="role-card__apply-wrap">
            <a
              href={buildGoUrl('general-portal', `platform-${slug}`)}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="btn btn--primary"
            >
              <span>{t.common.applyOnMercor}</span>
              <span class="sr-only"> {t.common.externalLinkSr}</span>
            </a>
            <span class="referral-micro">{t.common.referralMicroLabel}</span>
          </div>
        ) : isMicro1 ? (
          <div class="role-card__apply-wrap">
            <a
              href={buildMicro1GoUrl('platform-micro1')}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="btn btn--primary"
            >
              <span>{ui.browseMicro1Jobs}</span>
              <span class="sr-only"> {t.common.externalLinkSr}</span>
            </a>
            <span class="referral-micro">{t.common.referralMicroLabel}</span>
          </div>
        ) : (
          <div class="role-card__apply-wrap">
            <a
              href={platform.official_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary"
            >
              <span>{ui.officialLinkLabel}</span>
            </a>
            <span class="referral-micro">{ui.noReferralMicro}</span>
          </div>
        )}
        <a href={getPagePath(lang, 'compare')} class="btn btn--secondary">
          {ui.compareOthersH2}
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="platform-facts-heading">
    <div class="container">
      <h2 id="platform-facts-heading">{ui.factsH2}</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{ui.colFact}</th>
              <th scope="col">{ui.colValue}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">{ui.rowOperator}</th>
              <td>{platform.name} ({platform.operator})</td>
            </tr>
            <tr>
              <th scope="row">{ui.rowOfficialUrl}</th>
              <td>
                <a href={platform.official_url} target="_blank" rel="noopener noreferrer">
                  {platform.official_url} ↗
                </a>
              </td>
            </tr>
            <tr>
              <th scope="row">{ui.rowWorkType}</th>
              <td>{platform.name}: {platform.what_kind_of_work}</td>
            </tr>
            <tr>
              <th scope="row">{ui.rowPayRange}</th>
              <td class="mono-cell">
                <strong>{platform.posted_pay_ranges.summary}</strong> (Source:{' '}
                <a href={platform.posted_pay_ranges.source_url} target="_blank" rel="noopener noreferrer">
                  {platform.posted_pay_ranges.source_url}
                </a>
                , checked {platform.posted_pay_ranges.source_date})
              </td>
            </tr>
            <tr>
              <th scope="row">{ui.rowPayment}</th>
              <td>{platform.name}: {platform.how_payment_works}</td>
            </tr>
            <tr>
              <th scope="row">{ui.rowCountries}</th>
              <td>{platform.name}: {platform.countries_accepted}</td>
            </tr>
            <tr>
              <th scope="row">{ui.rowSteps}</th>
              <td>
                <ol class="compact-ol">
                  {platform.application_steps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              </td>
            </tr>
            <tr>
              <th scope="row">{ui.rowReferral}</th>
              <td>{isMercor ? ui.referralYes : isMicro1 ? ui.referralMicro1 : ui.referralNo}</td>
            </tr>
            <tr>
              <th scope="row">{ui.rowChecked}</th>
              <td>
                <time datetime={platform.last_checked}>{platform.last_checked}</time>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="platform-roles-heading">
    <div class="container">
      <h2 id="platform-roles-heading">{ui.rolesTableH2}</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{ui.colField}</th>
              <th scope="col">{ui.colRole}</th>
              <th scope="col">{ui.colPostedRange}</th>
              <th scope="col">{ui.colDate}</th>
              <th scope="col">{ui.colSource}</th>
            </tr>
          </thead>
          <tbody>
            {platform.posted_pay_ranges.details.map((item) => {
              const matchingMercorRole = isMercor
                ? rolesRaw.find((r) => r.listingUrl === item.source_url)
                : undefined;
              const href =
                isMercor && matchingMercorRole
                  ? buildGoUrl(matchingMercorRole.id, `platform-${slug}`)
                  : isMicro1
                  ? buildMicro1GoUrl(`platform-${slug}`)
                  : item.source_url;
              return (
                <tr>
                  <td>{item.field}</td>
                  <td>
                    <strong>{platform.name}: {item.role}</strong>
                  </td>
                  <td class="mono-cell">
                    <strong>{item.range}</strong>
                  </td>
                  <td>{item.date}</td>
                  <td>
                    {isMercor ? (
                      <div class="table-action-cell">
                        <a
                          href={href}
                          target="_blank"
                          rel="sponsored noopener noreferrer"
                          class="table-apply-link"
                        >
                          {t.common.applyOnMercor} ↗
                        </a>
                        <span class="referral-micro">{t.common.referralMicroLabel}</span>
                      </div>
                    ) : isMicro1 ? (
                      <div class="table-action-cell">
                        <a
                          href={href}
                          target="_blank"
                          rel="sponsored noopener noreferrer"
                          class="table-apply-link"
                        >
                          {ui.browseMicro1Jobs}
                        </a>
                        <span class="referral-micro">{t.common.referralMicroLabel}</span>
                      </div>
                    ) : (
                      <div class="table-action-cell">
                        <a
                          href={href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="table-apply-link"
                        >
                          {ui.officialLinkLabel}
                        </a>
                        <span class="referral-micro">{ui.noReferralMicro}</span>
                      </div>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {content.sections.map((sec, idx) => (
    <section class="section" aria-labelledby={`sec-h2-${idx}`}>
      <div class="container">
        <h2 id={`sec-h2-${idx}`}>{sec.h2}</h2>
        <div class="article-prose">
          {sec.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section" aria-labelledby="platform-faq-heading">
    <div class="container">
      <h2 id="platform-faq-heading">{ui.faqH2}</h2>
      <FaqList items={content.faqs} />
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="matching-audiences-heading">
    <div class="container">
      <h2 id="matching-audiences-heading">{ui.matchingAudiencesH2}</h2>
      <ul class="related-links-grid">
        {platform.audiences.map((aud) => (
          <li>
            <a href={getAudiencePath(lang, aud as AudienceSlug)} class="related-card-link">
              {t.audiences[aud as AudienceSlug].label} →
            </a>
          </li>
        ))}
      </ul>

      <h2 id="compare-others-heading" class="mt-space-8">
        {ui.compareOthersH2}
      </h2>
      <ul class="related-links-grid">
        <li>
          <a href={getPagePath(lang, 'compare')} class="related-card-link">
            Compare All 6 Platforms →
          </a>
        </li>
        <li>
          <a href={getPagePath(lang, 'pay-index')} class="related-card-link">
            Edithsi AI Work Pay Index (CSV) →
          </a>
        </li>
        {PLATFORM_SLUGS.filter((s) => s !== slug).map((otherSlug) => {
          const other = platforms.find((p) => p.slug === otherSlug)!;
          return (
            <li>
              <a href={getPlatformPath(lang, otherSlug)} class="related-card-link">
                {other.name} ({other.posted_pay_ranges.summary.split('(')[0].trim()}) →
              </a>
            </li>
          );
        })}
      </ul>

      <AuthorBox lang={lang} />
    </div>
  </section>
</BaseLayout>
