---
// Review with a lawyer before launch
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CHECKED_ON, OPERATOR } from '../../config';
import type { Lang } from '../../i18n';
import { getDictionary, interpolate } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---
<!-- Review with a lawyer before launch -->
<BaseLayout
  lang={lang}
  page="privacy"
  title={t.privacyPage.metaTitle}
  description={t.privacyPage.metaDescription}
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">{t.privacyPage.eyebrow}</span>
      <h1>{t.privacyPage.title}</h1>
      <p class="role-card__pay-disclaimer mb-space-4">
        {t.privacyPage.lastUpdatedLabel}: <time datetime={CHECKED_ON}>{CHECKED_ON}</time>
      </p>
      <p class="lead">{t.privacyPage.intro}</p>

      {
        t.privacyPage.sections.map((sec) => (
          <div class="prose-section">
            <h2>{sec.heading}</h2>
            <p>
              {interpolate(sec.body, {
                name: OPERATOR.name,
                city: OPERATOR.city,
                email: OPERATOR.email,
                checkedOn: CHECKED_ON,
              })}
            </p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
