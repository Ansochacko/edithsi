---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorBox from '../AuthorBox.astro';
import rolesRaw from '../../data/roles.json';
import platforms from '../../data/platforms.json';
import { buildGoUrl, CHECKED_ON } from '../../config';
import {
  AUDIENCE_SLUGS,
  PLATFORM_SLUGS,
  getDictionary,
  getPagePath,
  getAudiencePath,
  getPlatformPath,
  getGuidePath,
  interpolate,
  type Lang,
  type AudienceSlug,
} from '../../i18n';
import type { RoleEntry } from '../RoleCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const roles = rolesRaw as RoleEntry[];
const featuredRoles = [...roles]
  .sort((a, b) => b.maxPay - a.maxPay || b.minPay - a.minPay);

const generalReferralHref = buildGoUrl('general-portal', 'home');

const MICRO1_PREVIEW_LABELS: Record<Lang, string> = {
  en: 'Also hiring experts: micro1 →',
  fi: 'Myös asiantuntijoita hakeva alusta: micro1 →',
  sv: 'Anlitar även experter: micro1 →',
  de: 'Sucht ebenfalls Experten: micro1 →',
  fr: 'Recrute également des experts : micro1 →',
  es: 'También contrata especialistas: micro1 →',
};
const micro1PreviewText = MICRO1_PREVIEW_LABELS[lang] ?? MICRO1_PREVIEW_LABELS.en;

const audienceChoices = AUDIENCE_SLUGS.map((slug) => {
  const matchingCount = roles.filter((r) => r.audiences.includes(slug)).length;
  const countLabel =
    matchingCount === 1
      ? interpolate(t.home.roleCountSingular, { count: matchingCount })
      : interpolate(t.home.roleCountPlural, { count: matchingCount });
  return {
    slug,
    shortChoice: t.audiences[slug].shortChoice,
    label: t.audiences[slug].label,
    description: t.audiences[slug].description,
    count: matchingCount,
    countLabel,
    href: getAudiencePath(lang, slug),
  };
});

