  Array<{ stage: string; time: string; title: string; desc: string }>
> = {
  en: [
    { stage: 'STAGE 01', time: '5–10 MIN', title: 'Apply with CV', desc: 'Verify your academic degrees, board certifications, and work background through standard document upload.' },
    { stage: 'STAGE 02', time: '~20 MIN', title: 'AI Interview', desc: 'Complete a brief asynchronous video dialogue and domain-specific prompt evaluation to assess factual depth.' },
    { stage: 'STAGE 03', time: '48–72H', title: 'Get Verified', desc: 'Credentials vetted by audit teams. Your profile enters the designated qualified talent pool index.' },
    { stage: 'STAGE 04', time: 'DISPATCH', title: 'Receive Invites', desc: 'Matched directly to frontier AI foundation model training tasks as enterprise client batches open (not guaranteed).' },
  ],
