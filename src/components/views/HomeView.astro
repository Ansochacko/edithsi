    { stage: 'STAGE 03', time: '48–72 H', title: 'Verifiering', desc: 'Din profil granskas och läggs till i det kvalificerade expertregistret.' },
    { stage: 'STAGE 04', time: 'DISPATCH', title: 'Projektinbjudningar', desc: 'Få uppdragserbjudanden när nya projektomgångar öppnas (ej garanterat).' },
