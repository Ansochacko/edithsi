    hubHeading: string;
    hubLead: string;
    compareCta: string;
    payIndexCta: string;
    glossaryCta: string;
    surveyCta: string;
    guidesHeading: string;
    guidesSub: string;
    guideLinks: Array<{ slug: 'remote-side-jobs-from-home' | 'taxes-toiminimi-yel-finland' | 'unemployment-benefits-ai-work' | 'ai-interview-preparation' | 'avoid-ai-job-scams' | 'ai-training-for-phds-and-students'; title: string; desc: string }>;
  }
> = {
  en: {
    hubHeading: 'Compare 6 AI-Training Platforms & Original Pay Data',
    hubLead: `I track official public listings, payment rails, and European eligibility across Mercor, Mindrift, Alignerr, Outlier, micro1, and Handshake AI (last checked ${CHECKED_ON}).`,
    compareCta: 'Compare All 6 Platforms',
