      { slug: 'unemployment-benefits-ai-work', title: 'KI-Arbeit & Arbeitslosengeld (Kela, Agentur für Arbeit)', desc: 'Warum Nebentätigkeiten vorab gemeldet werden müssen.' },
      { slug: 'ai-interview-preparation', title: 'Vorbereitung auf das automatisierte KI-Interview', desc: 'Ablauf bei Mercor, micro1, Outlier und Mindrift.' },
      { slug: 'avoid-ai-job-scams', title: 'Gefälschte KI-Jobangebote sicher erkennen', desc: 'Offizielle Domains (@mercor.com, @mercor.expert) prüfen und Gebührenfallen meiden.' },
      { slug: 'ai-training-for-phds-and-students', title: 'KI-Training für Promovierende & Studierende', desc: 'MINT-, Rechts- und Geisteswissenschafts-Projekte für Akademiker.' },
