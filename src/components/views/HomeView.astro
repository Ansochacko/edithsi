const STEPS = STAGES_BY_LANG[lang] ?? STAGES_BY_LANG.en;

const getLocalizedRole = (id: string, role: RoleEntry) => {
  const rolesDict = t.rolesData as Record<string, { title: string; pay: string; whoItSuits: string }> | undefined;
  const match = rolesDict?.[id];
  return {
    title: match?.title || role.title,
    pay: match?.pay || role.pay,
    whoItSuits: match?.whoItSuits || role.whoItSuits,
  };
};
---

<BaseLayout
  lang={lang}
  page="home"
  title={t.home.metaTitle}
  description={t.home.metaDescription}
>
  <div class="stitch-canvas">
    <!-- 01 // FIELD REGISTRY (HERO) -->
    <section class="stitch-section" aria-labelledby="hero-title">
      <div class="container stitch-grid">
        <!-- Rail Prefix (Col 1-3) -->
        <aside class="stitch-rail">
          <span class="section-index">01 // FIELD REGISTRY</span>
          <span class="section-meta">ISSUE 2026.11 · HELSINKI</span>
          <div class="archive-spec-box hidden lg:block">
            ARCHIVE REF: FI-MERC-POOL<br />
            STATUS: VERIFIED OPEN<br />
            DISPATCH: NORTH EUROPE
          </div>
        </aside>

        <!-- Hero Main (Col 4-8) -->
        <div class="stitch-hero-content">
          <div class="hero-header-stack">
            <span class="eyebrow">{t.home.eyebrow}</span>
            <h1 id="hero-title" class="hero-display-h1">
              {t.home.heroTitle}
            </h1>
          </div>
          <p class="lead">
            {t.home.heroLead}
          </p>
          <div class="btn-group">
            <a href="#talent-pools" class="btn btn--primary">
              {t.common.viewAllRoles}
            </a>
            <a href="#faq-section" class="btn btn--secondary">
              {t.home.faqCta ?? 'Read the honest FAQ →'}
            </a>
          </div>
          <div class="status-indicator-bar">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-text">{t.home.statusNote ?? 'Nordic independent contractor standard · Updated bi-weekly'}</span>
          </div>
        </div>

        <!-- Hero Data Panel (Col 9-12) -->
        <div class="stitch-hero-panel">
          <div class="hero-data-panel">
            <div class="hero-data-panel__header">
              <span>INDEX LEDGER SPEC</span>
              <span class="text-accent-secondary">Direct Intake</span>
            </div>
            <div class="hero-data-panel__stat">
              <span class="hero-data-panel__number">$35–180<span class="hero-data-panel__unit">/h</span></span>
              <span class="hero-data-panel__label">posted compensation ranges</span>
            </div>
            <div class="hero-data-panel__stat hero-data-panel__stat--bordered">
              <span class="hero-data-panel__number">~20 min</span>
              <span class="hero-data-panel__label">asynchronous video interview</span>
            </div>
            <div class="hero-data-panel__stat hero-data-panel__stat--bordered">
              <div class="hero-data-panel__free-row">
                <span class="hero-data-panel__number">€0</span>
                <span class="hero-data-panel__sub">(zero cost)</span>
              </div>
              <span class="hero-data-panel__label">to apply (always free)</span>
            </div>
            <div class="hero-data-panel__footer">
              <span>Checked {CHECKED_ON}</span>
              <span class="font-mono">NOT GUARANTEED</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 // DISCIPLINE FILTER -->
    <section class="stitch-section" aria-labelledby="discipline-heading">
      <div class="container stitch-grid">
        <aside class="stitch-rail">
          <span class="section-index">02 // DISCIPLINE FILTER</span>
          <span class="section-meta">FILTER ACTIVE POOLS</span>
          <p class="rail-note">Select your primary qualification credential to verify open cohort capacity.</p>
        </aside>

        <div class="stitch-main">
          <div class="section-heading-block">
            <h2 id="discipline-heading" class="section-heading-h2">
              {t.home.iWorkInLabel}
            </h2>
            <p class="section-lead-p">All roles require documented degree verification or professional standing.</p>
          </div>

          <div class="discipline-chips-grid">
            {
              audienceChoices.map((item) => (
                <a href={item.href} class="discipline-chip">
                  <span class="discipline-chip__title">{item.shortChoice}</span>
                  <span class="discipline-chip__count">({item.count} {item.count === 1 ? 'pool' : 'pools'})</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 03 // TALENT POOLS LEDGER -->
    <section class="stitch-section" id="talent-pools" aria-labelledby="talent-pools-heading">
      <div class="container stitch-grid">
        <aside class="stitch-rail">
          <span class="section-index">03 // TALENT POOLS</span>
          <span class="section-meta">ACTIVE POOLS</span>
          <p class="rail-note">
            Standing contractor pools on Mercor. Continuous evaluation cycles with direct client dispatch.
          </p>
          <div class="archive-spec-box hidden lg:block">
            STATUS CODE: RECV-BATCH-26<br />
            CONTRACT: 1099 / B2B CORRESPONDING
          </div>
        </aside>

        <div class="stitch-main">
          <div class="section-heading-block section-heading-block--split">
            <h2 id="talent-pools-heading" class="section-heading-h2">
              {t.home.featuredHeading}
            </h2>
            <span class="section-caption-label">Hourly compensation quoted in USD</span>
          </div>

          <!-- Ruled Index List Table -->
          <div class="roles-ledger-table">
            <div class="roles-ledger-table__header">
              <div>Field &amp; Pool Designation</div>
              <div>Role Designation</div>
              <div>Rate (USD)</div>
              <div>Credential Profile</div>
              <div class="text-right">Intake</div>
            </div>

            {
              featuredRoles.slice(0, 5).map((role) => {
                const audLabel = t.audiences[role.audiences[0] as AudienceSlug]?.shortChoice || 'Domain';
                const applyUrl = buildGoUrl(role.id, 'home-ledger');
                const loc = getLocalizedRole(role.id, role);
                return (
                  <div class="roles-ledger-row">
                    <div class="roles-ledger-row__field-col">
                      <span class="roles-ledger-row__field">{audLabel}</span>
                      <span class="roles-ledger-row__batch">Batch ID: {role.id.slice(0, 8).toUpperCase()}</span>
                    </div>
                    <div class="roles-ledger-row__role-col">
                      <span class="roles-ledger-row__role">{loc.title}</span>
                      <span class="roles-ledger-row__sub">{audLabel} Spec</span>
                    </div>
                    <div class="roles-ledger-row__pay-col">
                      <span class="roles-ledger-row__pay">${role.minPay}–${role.maxPay}<span class="roles-ledger-row__unit">/h</span></span>
                      <span class="roles-ledger-row__pay-label">Hourly rate</span>
                    </div>
                    <div class="roles-ledger-row__desc-col">
                      {loc.whoItSuits}
                    </div>
                    <div class="roles-ledger-row__apply-col">
                      <a
                        href={applyUrl}
                        target="_blank"
                        rel="sponsored noopener noreferrer"
                        class="roles-ledger-row__apply-btn"
                      >
                        Apply ↗
                      </a>
                      <span class="referral-ad-tag">referral · ad</span>
                    </div>
                  </div>
                );
              })
            }
          </div>

          <div class="table-footer-row">
            <a href={getPagePath(lang, 'roles')} class="footer-action-link">
              <span>{t.common.viewAllRoles} ({roles.length} open talent pools) →</span>
            </a>
            <a href={getPlatformPath(lang, 'micro1')} class="footer-action-link footer-action-link--alt">
              <span>{micro1PreviewText}</span>
            </a>
            <span class="table-footer-spec">ALL POOLS RUN ON OFFICIAL PLATFORM SERVERS</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 // INTAKE SEQUENCE -->
    <section class="stitch-section" aria-labelledby="intake-heading">
      <div class="container stitch-grid">
        <aside class="stitch-rail">
          <span class="section-index">04 // INTAKE SEQUENCE</span>
          <span class="section-meta">VERIFICATION PROCESS</span>
          <p class="rail-note">
            Standardized intake sequence for Northern European contractor onboarding. Zero upfront commitments required.
          </p>
        </aside>

        <div class="stitch-main">
          <div class="section-heading-block">
            <h2 id="intake-heading" class="section-heading-h2">
              {t.howPage.title}
            </h2>
            <p class="section-lead-p">Four linear milestones from registration to paid work batches.</p>
          </div>

          <div class="intake-stages">
            {
              STEPS.map((s) => (
                <div class="intake-stage-card">
                  <div class="intake-stage-card__header">
                    <span class="intake-stage-card__tag">{s.stage}</span>
                    <span class="intake-stage-card__time">{s.time}</span>
                  </div>
                  <h3 class="intake-stage-card__title">{s.title}</h3>
                  <p class="intake-stage-card__desc">{s.desc}</p>
                </div>
              ))
            }
          </div>

          <div class="engagement-note-banner">
            <div class="engagement-note-banner__content">
              <strong>NOTE ON ENGAGEMENT DURATION:</strong>
              <span>Contracts run on a flexible, part-time schedule typically varying between 5 and 25 hours weekly.</span>
            </div>
            <span class="engagement-note-banner__badge">STATUS: ACCEPTING</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 // FIELD QUESTIONS (FAQ) -->
    <section class="stitch-section" id="faq-section" aria-labelledby="faq-heading">
      <div class="container stitch-grid">
        <aside class="stitch-rail">
          <span class="section-index">05 // FIELD QUESTIONS</span>
          <span class="section-meta">HONEST FAQ</span>
          <p class="rail-note">
            Unvarnished clarification on compensation mechanisms, statutory taxation, and real intake probabilities.
          </p>
        </aside>

        <div class="stitch-main">
          <div class="section-heading-block">
            <h2 id="faq-heading" class="section-heading-h2">
              {t.home.realityHeading}
            </h2>
            <p class="section-lead-p">No hype, no recruitment promises. Read before submitting your credentials.</p>
          </div>

          <div class="faq-accordion-list">
            {
              t.home.realityPoints.map((pt, idx) => (
                <details class="faq-accordion-item" open={idx === 0}>
                  <summary class="faq-accordion-summary">
                    <div class="faq-accordion-summary__inner">
                      <span class="faq-accordion-num">0{idx + 1}</span>
                      <span class="faq-accordion-title">{pt.title}</span>
                    </div>
                    <span class="faq-accordion-caret" aria-hidden="true">▾</span>
                  </summary>
                  <div class="faq-accordion-body">
                    {pt.body}
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 06 // HUBS & COMPARISON -->
    <section class="stitch-section" aria-labelledby="platforms-hub-heading">
      <div class="container stitch-grid">
        <aside class="stitch-rail">
          <span class="section-index">06 // INDEPENDENT HUBS</span>
          <span class="section-meta">CROSS-PLATFORM DATA</span>
          <p class="rail-note">
            Full European coverage comparing rates, payout rails, and eligibility across major AI evaluation platforms.
          </p>
        </aside>

        <div class="stitch-main">
          <div class="section-heading-block">
            <h2 id="platforms-hub-heading" class="section-heading-h2">
              {hc.hubHeading}
            </h2>
            <p class="section-lead-p">{hc.hubLead}</p>
          </div>

          <div class="platforms-pill-grid">
            {
              PLATFORM_SLUGS.map((slug) => {
                const p = platforms.find((item) => item.slug === slug)!;
                return (
                  <a href={getPlatformPath(lang, slug)} class="platform-pill-card">
                    <div class="platform-pill-card__top">
                      <span class="platform-pill-card__name">{p.name}</span>
                      <span class="platform-pill-card__date">{p.last_checked}</span>
                    </div>
                    <span class="platform-pill-card__desc">{p.posted_pay_ranges.summary}</span>
                  </a>
                );
              })
            }
          </div>

          <div class="btn-group mt-space-6">
            <a href={getPagePath(lang, 'compare')} class="btn btn--primary">
              {hc.compareCta}
            </a>
            <a href={getPagePath(lang, 'pay-index')} class="btn btn--secondary">
              {hc.payIndexCta}
            </a>
            <a href={getPagePath(lang, 'glossary')} class="btn btn--secondary">
              {hc.glossaryCta}
            </a>
            <a href={getPagePath(lang, 'survey')} class="btn btn--secondary">
              {hc.surveyCta}
            </a>
          </div>

          <div class="guides-sub-block mt-space-10">
            <h3 class="section-sub-h3">{hc.guidesHeading}</h3>
            <p class="section-lead-p">{hc.guidesSub}</p>
            <div class="guides-card-grid">
              {
                hc.guideLinks.map((g) => (
                  <a href={getGuidePath(lang, g.slug)} class="guide-card-item">
                    <span class="guide-card-item__title">{g.title}</span>
                    <span class="guide-card-item__desc">{g.desc}</span>
                  </a>
                ))
              }
            </div>
          </div>

          <div class="author-wrap mt-space-10">
            <AuthorBox lang={lang} />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
