---
import RolesView from '../../components/views/RolesView.astro';
import { NON_DEFAULT_LANGUAGES, type Lang } from '../../i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
---

<RolesView lang={lang} />
