---
import GuidePageView from '../../components/views/GuidePageView.astro';
import { GUIDE_SLUGS, type GuideSlug } from '../../i18n';

export function getStaticPaths() {
  return GUIDE_SLUGS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: GuideSlug };
---

<GuidePageView lang="en" slug={slug} />
